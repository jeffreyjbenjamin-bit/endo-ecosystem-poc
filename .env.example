# === Storage backend: choose ONE (PoC uses local to start) ===
STORAGE_BACKEND=none    # s3 | azureblob | none

# AWS (only if/when you switch to S3)
AWS_REGION=us-east-1
S3_BUCKET=endo-poc-raw

# Azure (only if/when you switch to Blob)
AZURE_BLOB_ACCOUNT=
AZURE_BLOB_KEY=
AZURE_BLOB_CONTAINER=endo-poc-raw

# SQLite PoC DB path
SQLITE_PATH=./data/documents.db

# API endpoints
CTGOV_BASE=https://clinicaltrials.gov/api/v2/studies
PUBMED_EUTILS_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# === Web Search (pick ONE; Bing recommended first) ===
BING_SEARCH_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Optional allowlist (comma-separated hostnames). Leave empty to allow all.
SEARCH_ALLOW_HOSTS=pubmed.ncbi.nlm.nih.gov, clinicaltrials.gov, reporter.nih.gov, ema.europa.eu, fda.gov, www.biorxiv.org, www.medrxiv.org, api.openalex.org, www.nature.com, www.sciencedirect.com

# === Anthropic Claude (newsletter generation + Ask AI chat) ===
# Secret: set in .env locally and as an App Service application setting on Azure.
# Without it, the newsletter features keep using Azure OpenAI GPT-5.1.
ANTHROPIC_API_KEY=
# Model for every Claude feature (switch models here; no code change needed)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional per-feature overrides
# ANTHROPIC_MODEL_NEWSLETTER=claude-sonnet-5-5
# ANTHROPIC_MODEL_CHAT=claude-sonnet-5-5
# ANTHROPIC_EFFORT_NEWSLETTER=high      # low | medium | high | xhigh | max
# ANTHROPIC_EFFORT_CHAT=medium
# ANTHROPIC_MAX_RETRIES=4               # retries for rate limits / server / network errors
# ANTHROPIC_TIMEOUT=600                 # seconds per request
# ANTHROPIC_FALLBACKS=default           # server-side refusal fallback; "off" to disable
# ANTHROPIC_PRICE_CLAUDE_SONNET_5_5=2,10,2.5,0.2   # USD per 1M tokens: in,out,cache write,cache read
# anthropic (default) or azure - which provider the newsletter features use
NEWSLETTER_AI_PROVIDER=anthropic
